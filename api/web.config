<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="config.example.php" />
          <add segment="db.php" />
          <add segment="auth.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <handlers>
      <remove name="OPTIONSVerbHandler" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Auth-Token" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
